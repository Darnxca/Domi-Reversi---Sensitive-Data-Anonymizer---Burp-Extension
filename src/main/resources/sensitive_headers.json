{
  "_comment": "Domi Reversi - lista estendibile degli header sensibili. Ogni chiave in 'strategies' e' una strategia di anonimizzazione applicata al VALORE degli header elencati (il nome dell'header resta visibile). Gli header in 'keep' vengono lasciati intatti (solo gli host gia' noti vengono sostituiti). Gli header non elencati il cui nome contiene parole sensibili (token, secret, session, api-key, csrf...) vengono mascherati per intero; tutti gli altri vengono scansionati. Modifica liberamente questo file per estendere la copertura.",
  "strategies": {
    "host": ["Host", "X-Host", "X-Original-Host", ":authority"],
    "auth_token": ["Authorization", "Proxy-Authorization", "X-Authorization"],
    "cookie": ["Cookie", "Cookie2"],
    "ip": [
      "X-Forwarded-For",
      "X-Real-IP",
      "Forwarded",
      "X-Client-IP",
      "Client-IP",
      "True-Client-IP",
      "X-Originating-IP",
      "X-Remote-IP",
      "X-Remote-Addr",
      "CF-Connecting-IP",
      "CF-Connecting-IPv6",
      "Fastly-Client-IP",
      "X-Cluster-Client-IP",
      "X-Forwarded-Host",
      "X-Forwarded-Server",
      "X-Original-Forwarded-For",
      "X-Envoy-External-Address",
      "X-ProxyUser-Ip",
      "X-Azure-ClientIP",
      "X-Azure-SocketIP"
    ],
    "referer_origin": ["Referer", "Origin"],
    "apikey": [
      "X-Api-Key",
      "Api-Key",
      "Apikey",
      "X-Apikey",
      "X-Goog-Api-Key",
      "Ocp-Apim-Subscription-Key",
