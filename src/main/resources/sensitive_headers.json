{
  "_comment": "Domi Reversi - lista estendibile degli header sensibili. Ogni chiave in 'strategies' e' una strategia di anonimizzazione applicata al VALORE degli header elencati (il nome dell'header resta visibile). Gli header in 'keep' non vengono mai modificati. Modifica liberamente questo file per estendere la copertura.",
  "strategies": {
    "host": ["Host"],
    "auth_token": ["Authorization", "Proxy-Authorization"],
    "cookie": ["Cookie"],
    "ip": [
      "X-Forwarded-For",
      "X-Real-IP",
      "Forwarded",
      "X-Client-IP",
      "True-Client-IP",
      "X-Originating-IP",
      "CF-Connecting-IP",
      "Fastly-Client-IP",
      "X-Cluster-Client-IP",
      "X-Forwarded-Host"
    ],
    "referer_origin": ["Referer", "Origin"],
    "apikey": ["X-Api-Key", "Api-Key", "Apikey", "X-Apikey"],
    "token": [
      "X-Auth-Token",
      "X-CSRF-Token",
      "X-Csrf-Token",
      "X-XSRF-Token",
      "X-Access-Token",
      "X-Session-Token",
      "X-Subject-Token"
    ],
    "user_agent": ["User-Agent"],
    "set_cookie": ["Set-Cookie"],
    "location": ["Location", "Content-Location"],
    "auth_challenge": ["WWW-Authenticate", "Proxy-Authenticate"],
    "redact": [
      "Server",
      "X-Powered-By",
      "X-AspNet-Version",
      "X-AspNetMvc-Version",
      "X-Generator",
      "Dxp-Sap",
      "X-User-Logon-Language",
      "Via",
      "X-Runtime",
      "X-Version",
      "X-Backend-Server",
      "X-Served-By",
      "X-Drupal-Cache",
      "X-Varnish"
    ],
    "host_scan": [
      "Content-Security-Policy",
      "Content-Security-Policy-Report-Only",
      "Access-Control-Allow-Origin",
      "Link",
      "Report-To",
      "Alt-Svc"
    ]
  },
  "keep": [
    "Content-Type",
    "Content-Length",
    "Accept",
    "Accept-Encoding",
    "Accept-Language",
    "Accept-Charset",
    "Accept-Ranges",
    "Cache-Control",
    "Connection",
    "Pragma",
    "Vary",
    "Date",
    "Expires",
    "Last-Modified",
    "Content-Encoding",
    "Content-Language",
    "Transfer-Encoding",
    "Upgrade",
    "Allow",
    "X-Frame-Options",
    "X-Content-Type-Options",
    "X-XSS-Protection",
    "Strict-Transport-Security",
    "Referrer-Policy",
    "Permissions-Policy",
    "Access-Control-Allow-Methods",
    "Access-Control-Allow-Headers",
    "Access-Control-Allow-Credentials",
    "Access-Control-Max-Age",
    "Retry-After",
    "TE",
    "DNT"
  ],
  "options": {
    "anonymize_user_agent": false
  }
}
