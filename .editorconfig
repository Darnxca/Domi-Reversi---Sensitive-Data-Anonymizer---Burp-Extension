root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml,json,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

# le fixture dei test vanno lasciate esattamente come sono
[src/test/resources/**]
trim_trailing_whitespace = false
insert_final_newline = false
